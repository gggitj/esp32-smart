# ESP32-S3-N16R8: 16MB flash / 8MB PSRAM. LinkIt pogo wired-link bring-up.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
# UART0 is the PBR1 data channel; console text would corrupt its binary frames.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Keep the default ROM log scheme; never burn log-suppression eFuses.
CONFIG_BOOT_ROM_LOG_ALWAYS_ON=y
